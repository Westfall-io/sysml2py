;
Structure:
	(isAbstract?='abstract')? (ownedRelationship+=PrefixMetadataMember)* 'struct' (isSufficient?='all')? ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? (ownedRelationship+=OwnedMultiplicity)? ((':>' | 'specializes') ownedRelationship+=Ownedsubclassification (',' ownedRelationship+=Ownedsubclassification)* | ('~' | 'conjugates') ownedRelationship+=ClassifierConjugation)? ('disjoint' 'from' ownedRelationship+=OwnedDisjoining (',' ownedRelationship+=OwnedDisjoining)* | 'unions' ownedRelationship+=Unioning (',' ownedRelationship+=Unioning)* | 'intersects' ownedRelationship+=Intersecting (',' ownedRelationship+=Intersecting)* | 'differences' ownedRelationship+=Differencing (',' ownedRelationship+=Differencing)*)* (';' | '{' (ownedRelationship+=NonFeatureMember | ownedRelationship+=FeatureMember | ownedRelationship+=AliasMember | ownedRelationship+=Import)* '}')
;
Association:
	(isAbstract?='abstract')? (ownedRelationship+=PrefixMetadataMember)* 'assoc' (isSufficient?='all')? ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? (ownedRelationship+=OwnedMultiplicity)? ((':>' | 'specializes') ownedRelationship+=Ownedsubclassification (',' ownedRelationship+=Ownedsubclassification)* | ('~' | 'conjugates') ownedRelationship+=ClassifierConjugation)? ('disjoint' 'from' ownedRelationship+=OwnedDisjoining (',' ownedRelationship+=OwnedDisjoining)* | 'unions' ownedRelationship+=Unioning (',' ownedRelationship+=Unioning)* | 'intersects' ownedRelationship+=Intersecting (',' ownedRelationship+=Intersecting)* | 'differences' ownedRelationship+=Differencing (',' ownedRelationship+=Differencing)*)* (';' | '{' (ownedRelationship+=NonFeatureMember | ownedRelationship+=FeatureMember | ownedRelationship+=AliasMember | ownedRelationship+=Import)* '}')
;
AssociationStructure:
	(isAbstract?='abstract')? (ownedRelationship+=PrefixMetadataMember)* 'assoc' 'struct' (isSufficient?='all')? ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? (ownedRelationship+=OwnedMultiplicity)? ((':>' | 'specializes') ownedRelationship+=Ownedsubclassification (',' ownedRelationship+=Ownedsubclassification)* | ('~' | 'conjugates') ownedRelationship+=ClassifierConjugation)? ('disjoint' 'from' ownedRelationship+=OwnedDisjoining (',' ownedRelationship+=OwnedDisjoining)* | 'unions' ownedRelationship+=Unioning (',' ownedRelationship+=Unioning)* | 'intersects' ownedRelationship+=Intersecting (',' ownedRelationship+=Intersecting)* | 'differences' ownedRelationship+=Differencing (',' ownedRelationship+=Differencing)*)* (';' | '{' (ownedRelationship+=NonFeatureMember | ownedRelationship+=FeatureMember | ownedRelationship+=AliasMember | ownedRelationship+=Import)* '}')
;
