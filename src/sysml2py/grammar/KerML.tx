import KerMLExpressions

RootNamespace:
	 (ownedRelationship+=NamespaceMember | ownedRelationship+=AliasMember | ownedRelationship+=Import)*
;
OwnedRelatedElement:
	NonFeatureElement | FeatureElement
;
Dependency:
	(ownedRelationship+=PrefixMetadataAnnotation)* 'dependency' (('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? 'from')? client+=[SysML::Element|QualifiedName] (',' client+=[SysML::Element|QualifiedName])* 'to' supplier+=[SysML::Element|QualifiedName] (',' supplier+=[SysML::Element|QualifiedName])* (';' | '{' (ownedRelatedElement+=OwnedRelatedElement | ownedRelationship+=OwnedAnnotation)* '}')
;
Annotation:
	annotatedElement=[SysML::Element|QualifiedName]
;
OwnedAnnotation:
	ownedRelatedElement+=AnnotatingElement
;
AnnotatingElement:
	Comment | Documentation | TextualRepresentation | MetadataFeature
;
Comment:
	('comment' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? ('about' ownedRelationship+=Annotation (',' ownedRelationship+=Annotation)*)?)? body=REGULAR_COMMENT
;
Documentation:
	'doc' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? body=REGULAR_COMMENT
;
TextualRepresentation:
	('rep' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)?)? 'language' language=STRING_VALUE body=REGULAR_COMMENT
;
Namespace:
	(ownedRelationship+=PrefixMetadataMember)* 'namespace' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? (';' | '{' (ownedRelationship+=NamespaceMember | ownedRelationship+=AliasMember | ownedRelationship+=Import)* '}')
;
NamespaceMember:
	NonFeatureMember | NamespaceFeatureMember
;
NonFeatureMember:
	(visibility=VisibilityIndicator)? ownedRelatedElement+=MemberElement
;
NamespaceFeatureMember:
	(visibility=VisibilityIndicator)? ownedRelatedElement+=FeatureElement
;
AliasMember:
	(visibility=VisibilityIndicator)? 'alias' ('<' memberShortName=Name '>')? (memberName=Name)? 'for' memberElement=[SysML::Element|QualifiedName] (';' | '{' (ownedRelatedElement+=OwnedRelatedElement | ownedRelationship+=OwnedAnnotation)* '}')
;
Import:
	(MembershipImport | NamespaceImport) (';' | '{' (ownedRelatedElement+=OwnedRelatedElement | ownedRelationship+=OwnedAnnotation)* '}')
;
MembershipImport:
	(visibility=VisibilityIndicator)? 'import' (isImportAll?='all')? importedMembership=[SysML::Membership|QualifiedName] ('::' isRecursive?='**')?
;
NamespaceImport:
	(visibility=VisibilityIndicator)? 'import' (isImportAll?='all')? (importedNamespace=[SysML::Namespace|QualifiedName] '::' '*' ('::' isRecursive?='**')? | ownedRelatedElement+=FilterPackage)
;
FilterPackage:
	ownedRelationship+=FilterPackageImport (ownedRelationship+=FilterPackageMember)+
;
FilterPackageImport:
	FilterPackageMembershipImport | FilterPackageNamespaceImport
;
FilterPackageMembershipImport:
	importedMembership=[SysML::Membership|QualifiedName] ('::' isRecursive?='**')?
;
FilterPackageNamespaceImport:
	importedNamespace=[SysML::Namespace|QualifiedName] '::' '*' ('::' isRecursive?='**')?
;
FilterPackageMember:
	visibility=FilterPackageMemberVisibility ownedRelatedElement+=OwnedExpression ']'
;
FilterPackageMemberVisibility:
	private = '['
;
VisibilityIndicator:
	public = 'public' | private = 'private' | protected = 'protected'
;
MemberElement:
	AnnotatingElement | NonFeatureElement
;
NonFeatureElement:
	Dependency | Namespace | Package | LibraryPackage | Multiplicity | Type | Classifier | Class | Structure | Metaclass | DataType | Association | AssociationStructure | Interaction | Behavior | Function | Predicate | Specialization | Conjugation | FeatureTyping | Subclassification | Disjoining | FeatureInverting | Subsetting | Redefinition | TypeFeaturing
;
FeatureElement:
	Feature | Step | Expression | BooleanExpression | Invariant | Connector | BindingConnector | Succession | ItemFlow | SuccessionItemFlow
;
Package:
	(ownedRelationship+=PrefixMetadataMember)* 'package' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? (';' | '{' (ownedRelationship+=NamespaceMember | ownedRelationship+=ElementFilterMember | ownedRelationship+=AliasMember | ownedRelationship+=Import)* '}')
;
LibraryPackage:
	(isStandard?='standard')? 'library' (ownedRelationship+=PrefixMetadataMember)* 'package' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? (';' | '{' (ownedRelationship+=NamespaceMember | ownedRelationship+=ElementFilterMember | ownedRelationship+=AliasMember | ownedRelationship+=Import)* '}')
;
ElementFilterMember:
	(visibility=VisibilityIndicator)? 'filter' ownedRelatedElement+=OwnedExpression ';'
;
Type:
	(isAbstract?='abstract')? (ownedRelationship+=PrefixMetadataMember)* 'type' (isSufficient?='all')? ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? (ownedRelationship+=OwnedMultiplicity)? ((':>' | 'specializes') ownedRelationship+=OwnedSpecialization (',' ownedRelationship+=OwnedSpecialization)* | ('~' | 'conjugates') ownedRelationship+=OwnedConjugation)+ ('disjoint' 'from' ownedRelationship+=OwnedDisjoining (',' ownedRelationship+=OwnedDisjoining)* | 'unions' ownedRelationship+=Unioning (',' ownedRelationship+=Unioning)* | 'intersects' ownedRelationship+=Intersecting (',' ownedRelationship+=Intersecting)* | 'differences' ownedRelationship+=Differencing (',' ownedRelationship+=Differencing)*)* (';' | '{' (ownedRelationship+=NonFeatureMember | ownedRelationship+=FeatureMember | ownedRelationship+=AliasMember | ownedRelationship+=Import)* '}')
;
FeatureMember:
	TypeFeatureMember | OwnedFeatureMember
;
TypeFeatureMember:
	(visibility=VisibilityIndicator)? 'member' ownedRelatedElement+=FeatureElement
;
OwnedFeatureMember:
	(visibility=VisibilityIndicator)? ownedRelatedElement+=FeatureElement
;
Specialization:
	('specialization' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)?)? 'subtype' (specific=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain) (':>' | 'specializes') (general=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain) (';' | '{' (ownedRelatedElement+=OwnedRelatedElement | ownedRelationship+=OwnedAnnotation)* '}')
;
OwnedSpecialization:
	general=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain
;
Conjugation:
	('conjugation' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)?)? 'conjugate' (conjugatedType=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain) ('~' | 'conjugates') (originalType=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain) (';' | '{' (ownedRelatedElement+=OwnedRelatedElement | ownedRelationship+=OwnedAnnotation)* '}')
;
OwnedConjugation:
	originalType=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain
;
Disjoining:
	('disjoining' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)?)? 'disjoint' (typeDisjoined=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain) 'from' (disjoiningType=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain) (';' | '{' (ownedRelatedElement+=OwnedRelatedElement | ownedRelationship+=OwnedAnnotation)* '}')
;
OwnedDisjoining:
	disjoiningType=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain
;
Unioning:
	unioningType=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain
;
Intersecting:
	intersectingType=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain
;
Differencing:
	differencingType=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain
;
Classifier:
	(isAbstract?='abstract')? (ownedRelationship+=PrefixMetadataMember)* 'classifier' (isSufficient?='all')? ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? (ownedRelationship+=OwnedMultiplicity)? ((':>' | 'specializes') ownedRelationship+=Ownedsubclassification (',' ownedRelationship+=Ownedsubclassification)* | ('~' | 'conjugates') ownedRelationship+=ClassifierConjugation)? ('disjoint' 'from' ownedRelationship+=OwnedDisjoining (',' ownedRelationship+=OwnedDisjoining)* | 'unions' ownedRelationship+=Unioning (',' ownedRelationship+=Unioning)* | 'intersects' ownedRelationship+=Intersecting (',' ownedRelationship+=Intersecting)* | 'differences' ownedRelationship+=Differencing (',' ownedRelationship+=Differencing)*)* (';' | '{' (ownedRelationship+=NonFeatureMember | ownedRelationship+=FeatureMember | ownedRelationship+=AliasMember | ownedRelationship+=Import)* '}')
;
Subclassification:
	('specialization' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)?)? 'subclassifier' subclassifier=[SysML::Classifier|QualifiedName] (':>' | 'specializes') superclassifier=[SysML::Classifier|QualifiedName] (';' | '{' (ownedRelatedElement+=OwnedRelatedElement | ownedRelationship+=OwnedAnnotation)* '}')
;
Ownedsubclassification:
	superclassifier=[SysML::Classifier|QualifiedName]
;
ClassifierConjugation:
	originalType=[SysML::Classifier|QualifiedName]
;
FeatureDirection:
	in = 'in' | out = 'out' | inout = 'inout'
;
Feature:
	(direction=FeatureDirection)? (isAbstract?='abstract')? (isComposite?='composite' | isPortion?='portion')? (isReadOnly?='readonly')? (isDerived?='derived')? (isEnd?='end')? (ownedRelationship+=PrefixMetadataMember)* ('feature'? (isSufficient?='all')? (('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name) (((((':' | 'typed' 'by') ownedRelationship+=OwnedFeatureTyping (',' ownedRelationship+=OwnedFeatureTyping)* | (':>' | 'subsets') ownedRelationship+=OwnedSubsetting (',' ownedRelationship+=OwnedSubsetting)* | ReferencesKeyword ownedRelationship+=OwnedReferenceSubsetting | (':>>' | 'redefines') ownedRelationship+=OwnedRedefinition (',' ownedRelationship+=OwnedRedefinition)*))+ (ownedRelationship+=OwnedMultiplicity | (ownedRelationship+=OwnedMultiplicity)? (isOrdered?='ordered' isNonunique?='nonunique'? | isNonunique?='nonunique' isOrdered?='ordered'?))? ((':' | 'typed' 'by') ownedRelationship+=OwnedFeatureTyping (',' ownedRelationship+=OwnedFeatureTyping)* | (':>' | 'subsets') ownedRelationship+=OwnedSubsetting (',' ownedRelationship+=OwnedSubsetting)* | ReferencesKeyword ownedRelationship+=OwnedReferenceSubsetting | (':>>' | 'redefines') ownedRelationship+=OwnedRedefinition (',' ownedRelationship+=OwnedRedefinition)*)* | (ownedRelationship+=OwnedMultiplicity | (ownedRelationship+=OwnedMultiplicity)? (isOrdered?='ordered' isNonunique?='nonunique'? | isNonunique?='nonunique' isOrdered?='ordered'?)) ((':' | 'typed' 'by') ownedRelationship+=OwnedFeatureTyping (',' ownedRelationship+=OwnedFeatureTyping)* | (':>' | 'subsets') ownedRelationship+=OwnedSubsetting (',' ownedRelationship+=OwnedSubsetting)* | ReferencesKeyword ownedRelationship+=OwnedReferenceSubsetting | (':>>' | 'redefines') ownedRelationship+=OwnedRedefinition (',' ownedRelationship+=OwnedRedefinition)*)*) | ('~' | 'conjugates') ownedRelationship+=FeatureConjugation)? | ((((':' | 'typed' 'by') ownedRelationship+=OwnedFeatureTyping (',' ownedRelationship+=OwnedFeatureTyping)* | (':>' | 'subsets') ownedRelationship+=OwnedSubsetting (',' ownedRelationship+=OwnedSubsetting)* | ReferencesKeyword ownedRelationship+=OwnedReferenceSubsetting | (':>>' | 'redefines') ownedRelationship+=OwnedRedefinition (',' ownedRelationship+=OwnedRedefinition)*))+ (ownedRelationship+=OwnedMultiplicity | (ownedRelationship+=OwnedMultiplicity)? (isOrdered?='ordered' isNonunique?='nonunique'? | isNonunique?='nonunique' isOrdered?='ordered'?))? ((':' | 'typed' 'by') ownedRelationship+=OwnedFeatureTyping (',' ownedRelationship+=OwnedFeatureTyping)* | (':>' | 'subsets') ownedRelationship+=OwnedSubsetting (',' ownedRelationship+=OwnedSubsetting)* | ReferencesKeyword ownedRelationship+=OwnedReferenceSubsetting | (':>>' | 'redefines') ownedRelationship+=OwnedRedefinition (',' ownedRelationship+=OwnedRedefinition)*)* | (ownedRelationship+=OwnedMultiplicity | (ownedRelationship+=OwnedMultiplicity)? (isOrdered?='ordered' isNonunique?='nonunique'? | isNonunique?='nonunique' isOrdered?='ordered'?)) ((':' | 'typed' 'by') ownedRelationship+=OwnedFeatureTyping (',' ownedRelationship+=OwnedFeatureTyping)* | (':>' | 'subsets') ownedRelationship+=OwnedSubsetting (',' ownedRelationship+=OwnedSubsetting)* | ReferencesKeyword ownedRelationship+=OwnedReferenceSubsetting | (':>>' | 'redefines') ownedRelationship+=OwnedRedefinition (',' ownedRelationship+=OwnedRedefinition)*)*) | ('~' | 'conjugates') ownedRelationship+=FeatureConjugation) (('disjoint' 'from' ownedRelationship+=OwnedDisjoining (',' ownedRelationship+=OwnedDisjoining)* | 'unions' ownedRelationship+=Unioning (',' ownedRelationship+=Unioning)* | 'intersects' ownedRelationship+=Intersecting (',' ownedRelationship+=Intersecting)* | 'differences' ownedRelationship+=Differencing (',' ownedRelationship+=Differencing)*) | 'chains' (ownedRelationship+=OwnedFeatureChaining | ownedRelationship+=OwnedFeatureChaining ('.' ownedRelationship+=OwnedFeatureChaining)+) | 'inverse' 'of' ownedRelationship+=OwnedFeatureInverting | 'featured' 'by' ownedRelationship+=OwnedTypeFeaturing (',' ownedRelationship+=OwnedTypeFeaturing)*)* | ownedRelationship+=PrefixMetadataMember | 'feature') (ownedRelationship+=FeatureValue | ownedRelationship+=FeatureValueExpression ownedRelationship+=EmptyFeatureWriteMember)? (';' | '{' (ownedRelationship+=NonFeatureMember | ownedRelationship+=FeatureMember | ownedRelationship+=AliasMember | ownedRelationship+=Import)* '}')
;
ReferencesKeyword:
	'::>' | 'references'
;
FeatureInverting:
	('inverting' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)?)? 'inverse' (featureInverted=[SysML::Feature|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain) 'of' (invertingFeature=[SysML::Feature|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain) (';' | '{' (ownedRelatedElement+=OwnedRelatedElement | ownedRelationship+=OwnedAnnotation)* '}')
;
OwnedFeatureInverting:
	invertingFeature=[SysML::Feature|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain
;
TypeFeaturing:
	'featuring' (('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? 'of')? featureOfType=[SysML::Feature|QualifiedName] 'by' featuringType=[SysML::Feature|QualifiedName] (';' | '{' (ownedRelatedElement+=OwnedRelatedElement | ownedRelationship+=OwnedAnnotation)* '}')
;
OwnedTypeFeaturing:
	featuringType=[SysML::Type|QualifiedName]
;
FeatureTyping:
	('specialization' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)?)? 'typing' typedFeature=[SysML::Feature|QualifiedName] (':' | 'typed' 'by') (type=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain) (';' | '{' (ownedRelatedElement+=OwnedRelatedElement | ownedRelationship+=OwnedAnnotation)* '}')
;
OwnedFeatureTyping:
	(type=[SysML::Type|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain)
;
Subsetting:
	('specialization' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)?)? 'subset' (subsettingFeature=[SysML::Feature|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain) (':>' | 'subsets') (subsettedFeature=[SysML::Feature|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain) (';' | '{' (ownedRelatedElement+=OwnedRelatedElement | ownedRelationship+=OwnedAnnotation)* '}')
;
OwnedSubsetting:
	subsettedFeature=[SysML::Feature|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain
;
OwnedReferenceSubsetting:
	referencedFeature=[SysML::Feature|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain
;
Redefinition:
	('specialization' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)?)? 'redefinition' (redefiningFeature=[SysML::Feature|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain) (':>>' | 'redefines') (redefinedFeature=[SysML::Feature|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain) (';' | '{' (ownedRelatedElement+=OwnedRelatedElement | ownedRelationship+=OwnedAnnotation)* '}')
;
OwnedRedefinition:
	redefinedFeature=[SysML::Feature|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain
;
FeatureConjugation:
	originalType=[SysML::Feature|QualifiedName]
;
FeatureValue:
	('=' | isDefault?='default' ('=' | isInitial?=':=')?) ownedRelatedElement+=OwnedExpression
;
FeatureValueExpression:
	isInitial?=':=' ownedRelatedElement+=OwnedExpression
;
EmptyFeatureWriteMember:
	ownedRelatedElement+=EmptyFeatureWrite
;
EmptyFeatureWrite:
	ownedRelationship+=EmptyTargetMember ownedRelationship+=EmptyParameterMember
;
EmptyTargetMember:
	ownedRelatedElement+=EmptyTargetParameter
;
EmptyTargetParameter:
	ownedRelationship+=TargetFeatureMember
;
TargetFeatureMember:
	ownedRelatedElement+=TargetFeature
;
TargetFeature:
	ownedRelationship+=EmptyFeatureMember
;
EmptyFeatureMember:
	ownedRelatedElement+=EmptyFeature
;
EmptyParameterMember:
	ownedRelatedElement+=EmptyFeature
;
Multiplicity:
	MultiplicitySubset | MultiplicityRange
;
MultiplicitySubset:
	'multiplicity' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? (':>' | 'subsets') ownedRelationship+=OwnedSubsetting (';' | '{' (ownedRelationship+=NonFeatureMember | ownedRelationship+=FeatureMember | ownedRelationship+=AliasMember | ownedRelationship+=Import)* '}')
;
MultiplicityRange:
	'multiplicity' ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? '[' ownedRelationship+=MultiplicityExpressionMember ('..' ownedRelationship+=MultiplicityExpressionMember)? ']' (';' | '{' (ownedRelationship+=NonFeatureMember | ownedRelationship+=FeatureMember | ownedRelationship+=AliasMember | ownedRelationship+=Import)* '}')
;
OwnedMultiplicity:
	ownedRelatedElement+=OwnedMultiplicityRange
;
OwnedMultiplicityRange:
	'[' ownedRelationship+=MultiplicityExpressionMember ('..' ownedRelationship+=MultiplicityExpressionMember)? ']'
;
MultiplicityExpressionMember:
	ownedRelatedElement+=(LiteralExpression | FeatureReferenceExpression)
;
DataType:
	(isAbstract?='abstract')? (ownedRelationship+=PrefixMetadataMember)* 'datatype' (isSufficient?='all')? ('<' declaredShortName=Name '>' (declaredName=Name)? | declaredName=Name)? (ownedRelationship+=OwnedMultiplicity)? ((':>' | 'specializes') ownedRelationship+=Ownedsubclassification (',' ownedRelationship+=Ownedsubclassification)* | ('~' | 'conjugates') ownedRelationship+=ClassifierConjugation)? ('disjoint' 'from' ownedRelationship+=OwnedDisjoining (',' ownedRelationship+=OwnedDisjoining)* | 'unions' ownedRelationship+=Unioning (',' ownedRelationship+=Unioning)* | 'intersects' ownedRelationship+=Intersecting (',' ownedRelationship+=Intersecting)* | 'differences' ownedRelationship+=Differencing (',' ownedRelationship+=Differencing)*)* (';' | '{' (ownedRelationship+=NonFeatureMember | ownedRelationship+=FeatureMember | ownedRelationship+=AliasMember | ownedRelationship+=Import)* '}')
;
Class:
